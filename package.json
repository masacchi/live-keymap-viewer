{
  "name": "live-keymap-viewer",
  "version": "0.1.0",
  "description": "Vial キーボードの押下キーとアクティブレイヤーをリアルタイム表示するデスクトップアプリ",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "package:win": "npm run build && node scripts/package-win.mjs",
    "deploy:win": "npm run package:win && node scripts/deploy-win.mjs",
    "installer:win": "npm run package:win && node scripts/installer-win.mjs",
    "prepare": "husky",
    "diag:hid": "node scripts/diag/hid-probe.mjs",
    "diag:webhid": "node scripts/diag/webhid-list.mjs",
    "shots": "node scripts/shots/run.mjs",
    "gen:icon": "node scripts/gen-icon.mjs"
  },
  "dependencies": {
    "xz-decompress": "^0.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@electron/get": "^5.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-hid": "^1.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.3",
    "husky": "^9.1.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
