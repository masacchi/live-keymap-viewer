# コミット前に、型チェック・lint(Biome)・テストを通す(npm run check)。
# 5秒ほどかかる。src-tauri/ を触ったときはRustの検査(npm run check:rust)も通す。
# 急ぎで飛ばしたいときは`git commit --no-verify`(またはHUSKY=0)。
#
# 注意: 見るのは作業ツリー全体で、ステージした内容だけではない。
# 一部だけステージしてコミットすると、ステージしていない変更も込みで検査される。

# VS Codeのソース管理画面などから呼ばれると、nvmのPATHが通っていないことがある
if ! command -v npm >/dev/null 2>&1; then
  NVM_SH="${NVM_DIR:-$HOME/.nvm}/nvm.sh"
  # shellcheck disable=SC1090
  [ -s "$NVM_SH" ] && . "$NVM_SH"
fi
if ! command -v npm >/dev/null 2>&1; then
  echo "pre-commit: npm が見つからない。Node.js の PATH を確かめること(飛ばすなら --no-verify)" >&2
  exit 1
fi

if ! npm run --silent check; then
  echo "" >&2
  echo "pre-commit: npm run check が通らなかったのでコミットを止めた。" >&2
  echo "  直してからコミットし直すこと。整形だけなら npm run format で直る。" >&2
  exit 1
fi

# Rust(src-tauri/)を触ったときだけ、Rustの検査も通す。コンテナで動くので数十秒かかる
# (WSLからならscripts/container.mjsがpodmanで中に入る)
if git diff --cached --name-only | grep -q '^src-tauri/'; then
  if ! npm run --silent check:rust; then
    echo "" >&2
    echo "pre-commit: npm run check:rust が通らなかったのでコミットを止めた。" >&2
    echo "  整形だけなら npm run container -- cargo fmt --manifest-path src-tauri/Cargo.toml で直る。" >&2
    exit 1
  fi
fi
